    "/api/Sales": {
      "get": {
        "tags": [
          "Sales"
        ],
        "parameters": [
          {
            "name": "take",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SaleDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
