  "components": {
    "schemas": {
      "DashboardSummaryDto": {
        "type": "object",
        "properties": {
          "totalMedicines": {
            "type": "integer",
            "format": "int32"
          },
          "totalStockValue": {
            "type": "number",
            "format": "double"
          },
          "totalSalesRevenue": {
            "type": "number",
            "format": "double"
          },
          "lowStockCount": {
            "type": "integer",
            "format": "int32"
          },
          "salesOverTime": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesPointDto"
            },
            "nullable": true
          },
          "stockLevels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockLevelDto"
            },
            "nullable": true
          },
          "topSelling": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopSellingDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MedicineDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "genericName": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "type": "number",
            "format": "double"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "supplier": {
            "type": "string",
            "nullable": true
          },
          "totalSold": {
            "type": "integer",
            "format": "int32"
          },
          "totalRevenue": {
            "type": "number",
            "format": "double"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "MedicineUpsertRequest": {
        "required": [
          "category",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "genericName": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "category": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "maximum": 9999999.99,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "supplier": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RecordSaleRequest": {
        "required": [
          "medicineId"
        ],
        "type": "object",
        "properties": {
          "medicineId": {
            "type": "integer",
            "format": "int32"
          },
          "quantitySold": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SaleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "medicineId": {
            "type": "integer",
            "format": "int32"
          },
          "medicineName": {
            "type": "string",
            "nullable": true
          },
          "quantitySold": {
            "type": "integer",
            "format": "int32"
          },
          "totalAmount": {
            "type": "number",
            "format": "double"
          },
          "saleDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "SalesPointDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "nullable": true
          },
          "revenue": {
            "type": "number",
            "format": "double"
          },
          "unitsSold": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "StockLevelDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "TopSellingDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "unitsSold": {
            "type": "integer",
            "format": "int32"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste the token returned by /api/auth/login.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Dashboard"
    },
    {
      "name": "Medicines"
    },
    {
      "name": "Reports"
    },
    {
      "name": "Sales"
    },
    {
      "name": "Test"
    }
  ]
}